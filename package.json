{
  "name": "@sinonjs/eslint-config",
  "description": "Common eslint config for Sinon",
  "version": "5.0.4",
  "repository": {
    "type": "git",
    "url": "http://github.com/sinonjs/eslint-config-sinon.git"
  },
  "scripts": {
    "lint": "eslint . ",
    "prettier:check": "prettier --check '**/*.{js, md}'",
    "prettier:write": "prettier --write '**/*.{js, md}'",
    "prepare": "husky",
    "version": "changes --commits --footer",
    "postversion": "git push --follow-tags && npm publish --access public",
    "test": "npm run lint"
  },
  "license": "BSD-3-Clause",
  "files": [
    "index",
    "LICENSE",
    "README.md",
    ".browserslistrc"
  ],
  "main": "index.js",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "dependencies": {
    "eslint": "^8.57.1",
    "eslint-plugin-compat": "^6.2.1",
    "eslint-plugin-jsdoc": "^62.7.1",
    "eslint-plugin-mocha": "^10.5.0"
  },
  "devDependencies": {
    "@studio/changes": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "prettier": "^3.8.1"
  },
  "lint-staged": {
    "*.{js,md}": "prettier --check",
    "*.js": "eslint --quiet"
  }
}
